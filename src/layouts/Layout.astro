---
const title = 'Paisa: private expense tracker for UPI';
const description = "Know what's safe to spend today. Paisa finds your UPI payments and keeps everything on your phone. Join the Android beta.";
const featureGraphic = 'https://raw.githubusercontent.com/jaimin1503/paisa/main/store/play/feature-graphic.png';
const appIcon = '/icon-512.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F4EE" />
    <link rel="icon" type="image/png" href={appIcon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Playfair+Display:wght@500&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={featureGraphic} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={featureGraphic} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --primary: #5f7d61;
    --primary-deep: #4a6550;
    --cream: #f7f4ee;
    --card: #fffdf8;
    --text: #1f1e1c;
    --muted: #6e6a62;
    --gold: #e9c46a;
    --line: rgba(31, 30, 28, 0.1);
    --shadow: 0 18px 50px rgba(61, 55, 43, 0.09);
    font-family: 'DM Sans', sans-serif;
    font-synthesis: none;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; background: var(--cream); color: var(--text); }
  a { color: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 { font-family: 'Playfair Display', Georgia, serif; font-weight: 500; letter-spacing: -0.035em; line-height: 1.08; }
  p { line-height: 1.55; }
  img { display: block; max-width: 100%; }

  @media (prefers-color-scheme: dark) {
    :root { color-scheme: dark; --primary: #a9bfa3; --primary-deep: #91aa8e; --cream: #141414; --card: #1e1e1e; --text: #f4f1ea; --muted: #b2aea5; --line: rgba(244, 241, 234, 0.13); --shadow: 0 18px 50px rgba(0, 0, 0, 0.22); }
  }
</style>
