---
import Layout from '../layouts/Layout.astro';

const appIcon = '/icon-512.png';
const groupLink = 'https://groups.google.com/g/ravenroll-testers/about';
const playLink = 'https://play.google.com/apps/testing/com.twopixellabs.paisa';
const privacyLink = 'https://jaimin1503.github.io/paisa/privacy-policy';
const screenshots = [
  { src: '/f1-home.png', alt: 'Paisa home screen showing safe to spend and detected UPI payments' },
  { src: '/f2-detected.png', alt: 'Paisa detected payments screen for reviewing payment alerts' },
  { src: '/f3-add.png', alt: 'Paisa add expense screen with quick Coffee 180 entry' },
  { src: '/f4-insights.png', alt: 'Paisa insights screen showing daily spending' },
  { src: '/f5-plan.png', alt: 'Paisa plan screen for budgets and recurring expenses' },
  { src: '/f6-privacy.png', alt: 'Paisa privacy screen describing on-device protection' },
];
---
<Layout>
  <main>
    <section class="hero section-pad" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-copy reveal">
          <div class="brand"><img src={appIcon} alt="Paisa app icon" /><span>Paisa</span></div>
          <h1 id="hero-title">Know what's safe to spend today.</h1>
          <p class="hero-sub">A private expense tracker for UPI. Paisa notices your payments, tells you what you can spend each day, and keeps everything on your phone.</p>
          <a class="button button-primary" href="#join">Join the beta <span aria-hidden="true">↗</span></a>
          <p class="hero-note">Free <span>·</span> Android <span>·</span> No account needed</p>
        </div>
        <div class="hero-visual reveal" aria-label="Paisa app preview">
          <img class="hero-shot-back" src={screenshots[1].src} alt="" aria-hidden="true" />
          <img class="hero-shot" src={screenshots[0].src} alt={screenshots[0].alt} fetchpriority="high" />
        </div>
      </div>
    </section>

    <section class="join section-pad" id="join" aria-labelledby="join-title">
      <div class="join-card reveal">
        <div class="join-heading">
          <p class="eyebrow">Closed beta</p>
          <h2 id="join-title">Get early access<br />in 2 steps.</h2>
          <p>Help us make Paisa useful for everyday life in India.</p>
        </div>
        <div class="steps">
          <article class="step">
            <div class="step-number">01</div>
            <div><h3>Join the tester group</h3><p>Sign in with the Google account you use on your Android phone and click Join group.</p><a class="text-button" href={groupLink} target="_blank" rel="noopener">Join the Google Group <span aria-hidden="true">↗</span></a></div>
          </article>
          <article class="step">
            <div class="step-number">02</div>
            <div><h3>Become a tester and install</h3><p>Open this link on the same Google account, tap Become a tester, then install Paisa from Google Play. It can take a few minutes to show up after joining.</p><a class="text-button" href={playLink} target="_blank" rel="noopener">Open the Play Store test <span aria-hidden="true">↗</span></a></div>
          </article>
        </div>
        <p class="join-note">Please keep Paisa installed and open it now and then for at least 14 days. Google requires an active test group before the app can launch publicly, so every tester really helps.</p>
      </div>
    </section>

    <section class="features section-pad" aria-labelledby="features-title">
      <div class="section-intro reveal"><p class="eyebrow">Made for real life</p><h2 id="features-title">A calmer way to<br />handle money.</h2></div>
      <div class="feature-grid">
        <article class="feature-card reveal"><div class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M17 7H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7" /></svg></div><h3>Safe to spend, daily</h3><p>One number every morning: what you can spend today after bills and savings.</p></article>
        <article class="feature-card reveal"><div class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z" /></svg></div><h3>UPI payments, found for you</h3><p>Optional. Paisa reads payment alerts from bank SMS and UPI apps on your phone, then you add them in one tap.</p></article>
        <article class="feature-card reveal"><div class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v16h16M8 16V9m4 7V6m4 10v-4" /></svg></div><h3>Type “Coffee 180”</h3><p>Quick entry fills in the amount and category for you.</p></article>
        <article class="feature-card reveal"><div class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></svg></div><h3>Budgets that start on payday</h3><p>Monthly and per-category limits, counted from the day you get paid.</p></article>
        <article class="feature-card reveal"><div class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg></div><h3>Recurring and reminders</h3><p>Rent, EMIs, SIPs and subscriptions are added on time, with reminders before they're due.</p></article>
        <article class="feature-card reveal"><div class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5m0 14h16M7 16v-3m4 3V8m4 8v-6m4 6V4" /></svg></div><h3>Insights that make sense</h3><p>Daily, weekly and monthly spending, compared fairly.</p></article>
      </div>
    </section>

    <section class="gallery section-pad" aria-labelledby="gallery-title">
      <div class="gallery-heading"><p class="eyebrow">See it in action</p><h2 id="gallery-title">Simple enough<br />to keep using.</h2></div>
      <div class="gallery-track">
        {screenshots.map((shot, index) => <img src={shot.src} alt={shot.alt} loading="lazy" class="gallery-shot" />)}
      </div>
    </section>

    <section class="privacy-band section-pad" aria-labelledby="privacy-title">
      <div class="privacy-layout">
        <div class="privacy-heading reveal"><p class="eyebrow">Private by design</p><h2 id="privacy-title">Your money stays<br />on your phone.</h2></div>
        <div class="privacy-content reveal"><div class="privacy-points"><p><span>01</span>No account or sign-up</p><p><span>02</span>No ads, no tracking</p><p><span>03</span>Works offline</p><p><span>04</span>Encrypted backups with your password</p></div><p class="privacy-copy">Paisa never connects to your bank and never moves money. Payment detection is optional and reads alerts only on your device. <a href={privacyLink} target="_blank" rel="noopener">Read the privacy policy <span aria-hidden="true">↗</span></a></p></div>
      </div>
    </section>

    <section class="faq section-pad" aria-labelledby="faq-title">
      <div class="faq-layout"><div class="faq-heading"><p class="eyebrow">Questions, answered</p><h2 id="faq-title">Good to know.</h2></div><div class="faq-list">
        <details><summary>Is it free?</summary><p>Yes. The beta is free.</p></details>
        <details><summary>Which phones does it work on?</summary><p>Android phones. Payment detection needs Android's Notification access, which you can turn off anytime.</p></details>
        <details><summary>Does Paisa see my bank account?</summary><p>No. It never connects to your bank. It only reads payment alerts that already arrive on your phone, if you turn that on.</p></details>
        <details><summary>I joined but can't find the app on Play</summary><p>Make sure you joined the group and opened the testing link with the same Google account that's signed in on your phone. It can take a few minutes after joining.</p></details>
        <details><summary>How do I give feedback?</summary><p>Email <a href="mailto:jaiminviramgama152@gmail.com">jaiminviramgama152@gmail.com</a>, or leave private feedback on the Play Store page.</p></details>
      </div></div>
    </section>
  </main>
  <footer class="footer section-pad"><div class="footer-brand"><img src={appIcon} alt="Paisa app icon" /><span>Paisa</span></div><p>Made in India by Two Pixel Labs</p><nav aria-label="Footer navigation"><a href={privacyLink} target="_blank" rel="noopener">Privacy policy</a><a href="mailto:jaiminviramgama152@gmail.com">Contact</a><span>© 2026</span></nav></footer>
</Layout>

<style>
  main { overflow: hidden; }
  .section-pad { padding: 96px max(24px, calc((100vw - 1180px) / 2)); }
  .hero { min-height: 720px; display: flex; align-items: center; background: radial-gradient(circle at 82% 28%, rgba(233,196,106,.15), transparent 32%), var(--cream); }
  .hero-inner { width: 100%; max-width: 1180px; margin: auto; display: grid; grid-template-columns: 0.9fr 1.1fr; align-items: center; gap: 72px; }
  .brand, .footer-brand { display: flex; align-items: center; gap: 14px; color: var(--primary-deep); font-size: 19px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
  .brand img { width: 58px; height: 58px; border-radius: 16px; box-shadow: var(--shadow); }
  .hero h1 { max-width: 600px; margin: 34px 0 24px; font-size: clamp(3.25rem, 6vw, 5.8rem); }
  .hero-sub { max-width: 535px; color: var(--muted); font-size: 20px; }
  .button, .text-button { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 12px; text-decoration: none; font-weight: 500; transition: transform .2s ease, background .2s ease, color .2s ease; }
  .button:hover, .text-button:hover { transform: translateY(-2px); }
  .button-primary { margin-top: 32px; padding: 0 24px; border-radius: 999px; background: var(--primary); color: #fff; }
  .button-primary:hover { background: var(--primary-deep); }
  .hero-note { margin-top: 16px; color: var(--muted); font-size: 14px; }.hero-note span { color: var(--gold); padding: 0 6px; }
  .hero-visual { position: relative; min-height: 610px; display: flex; align-items: center; justify-content: center; }.hero-shot, .hero-shot-back { width: min(340px, 65%); border-radius: 32px; box-shadow: 0 28px 70px rgba(31,30,28,.2); }.hero-shot { position: relative; z-index: 1; transform: rotate(3deg); }.hero-shot-back { position: absolute; transform: rotate(-7deg) translate(-28%, 2%); opacity: .72; }
  .eyebrow { margin-bottom: 16px; color: var(--primary-deep); font-size: 12px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; }.join { padding-top: 32px; }.join-card { max-width: 1180px; margin: auto; padding: clamp(28px, 5vw, 64px); border-radius: 28px; background: var(--primary); color: #fff; box-shadow: 0 20px 55px rgba(74,101,80,.2); }.join-card .eyebrow { color: #dbe6d5; }.join-card h2 { font-size: clamp(2.6rem, 5vw, 4.7rem); }.join-heading > p:last-child { margin-top: 20px; color: #e2ebe0; }.steps { display: grid; grid-template-columns: repeat(2, 1fr); gap: 48px; margin: 64px 0 42px; }.step { display: grid; grid-template-columns: 42px 1fr; gap: 20px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.3); }.step-number { color: var(--gold); font-size: 13px; font-weight: 500; letter-spacing: .1em; }.step h3 { font-family: 'DM Sans', sans-serif; font-size: 20px; letter-spacing: -.02em; }.step p { margin: 14px 0 20px; color: #e2ebe0; font-size: 15px; }.text-button { padding: 0; color: #fff; border-bottom: 1px solid rgba(255,255,255,.6); border-radius: 0; }.join-note { max-width: 800px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.3); color: #e2ebe0; font-size: 13px; }
  .features { background: var(--card); }.section-intro { max-width: 1180px; margin: auto auto 48px; }.section-intro h2, .gallery h2, .privacy-band h2, .faq h2 { font-size: clamp(2.7rem, 5vw, 4.8rem); }.feature-grid { max-width: 1180px; margin: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }.feature-card { min-height: 250px; padding: 28px; border: 1px solid var(--line); border-radius: 24px; background: var(--cream); transition: transform .25s ease, box-shadow .25s ease; }.feature-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }.icon { width: 42px; height: 42px; display: grid; place-items: center; margin-bottom: 34px; border-radius: 50%; background: var(--primary); color: #fff; }.icon svg { width: 21px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }.feature-card h3 { font-family: 'DM Sans', sans-serif; font-size: 19px; letter-spacing: -.02em; }.feature-card p { margin-top: 10px; color: var(--muted); font-size: 15px; }
  .gallery { background: var(--cream); }.gallery-heading { max-width: 1180px; margin: auto auto 45px; }.gallery-track { max-width: 1180px; margin: auto; display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 10px 0 24px; scrollbar-width: thin; }.gallery-shot { flex: 0 0 190px; width: 190px; border-radius: 22px; box-shadow: var(--shadow); scroll-snap-align: start; }
  .privacy-band { background: var(--primary-deep); color: #fff; }.privacy-layout { max-width: 1180px; margin: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }.privacy-band .eyebrow { color: #dbe6d5; }.privacy-points { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; border-top: 1px solid rgba(255,255,255,.3); }.privacy-points p { padding: 18px 8px 18px 0; border-bottom: 1px solid rgba(255,255,255,.3); font-size: 15px; }.privacy-points span { display: block; margin-bottom: 18px; color: var(--gold); font-size: 12px; }.privacy-copy { margin-top: 38px; color: #e2ebe0; font-size: 15px; }.privacy-copy a { display: inline-block; margin-top: 20px; color: #fff; text-underline-offset: 5px; }
  .faq { background: var(--card); }.faq-layout { max-width: 1180px; margin: auto; display: grid; grid-template-columns: .8fr 1.2fr; gap: 100px; }.faq-list details { border-top: 1px solid var(--line); }.faq-list details:last-child { border-bottom: 1px solid var(--line); }.faq-list summary { min-height: 68px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; list-style: none; font-size: 17px; font-weight: 500; }.faq-list summary::-webkit-details-marker { display: none; }.faq-list summary::after { content: '+'; color: var(--primary); font-size: 24px; font-weight: 400; }.faq-list details[open] summary::after { content: '−'; }.faq-list details p { max-width: 620px; padding: 0 32px 24px 0; color: var(--muted); font-size: 15px; }.faq-list a { color: var(--primary-deep); }.footer { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 24px; padding-top: 34px; padding-bottom: 34px; background: var(--card); border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }.footer-brand { color: var(--primary-deep); font-size: 16px; }.footer-brand img { width: 38px; height: 38px; border-radius: 11px; }.footer nav { display: flex; gap: 20px; }.footer a { text-underline-offset: 4px; }.reveal { animation: rise-in .7s ease both; }.feature-card:nth-child(2), .feature-card:nth-child(5) { animation-delay: .08s; }.feature-card:nth-child(3), .feature-card:nth-child(6) { animation-delay: .16s; }
  @keyframes rise-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 800px) { .section-pad { padding-top: 72px; padding-bottom: 72px; }.hero { padding-top: 64px; }.hero-inner, .privacy-layout, .faq-layout { grid-template-columns: 1fr; gap: 48px; }.hero-visual { min-height: 500px; }.hero-shot, .hero-shot-back { width: min(280px, 63%); }.steps, .feature-grid { grid-template-columns: repeat(2, 1fr); }.privacy-layout { gap: 40px; }.faq-layout { gap: 36px; }.footer { grid-template-columns: 1fr 1fr; }.footer nav { grid-column: 1 / -1; justify-content: space-between; } }
  @media (max-width: 520px) { .section-pad { padding-left: 20px; padding-right: 20px; }.hero h1 { font-size: 3.35rem; }.hero-sub { font-size: 17px; }.hero-visual { min-height: 430px; }.hero-shot, .hero-shot-back { width: 63%; }.steps, .feature-grid, .privacy-points { grid-template-columns: 1fr; }.steps { gap: 34px; margin-top: 42px; }.feature-card { min-height: auto; }.gallery-track { margin-right: -20px; padding-right: 20px; }.gallery-shot { flex-basis: 168px; width: 168px; }.footer { grid-template-columns: 1fr; gap: 14px; }.footer nav { grid-column: auto; flex-wrap: wrap; justify-content: flex-start; }.footer p { font-size: 12px; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; }.reveal, .feature-card { animation: none; transition: none; }.button, .text-button { transition: none; } }
</style>
